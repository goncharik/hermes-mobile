# macOS
.DS_Store

# Xcode / Tuist (generated project — Project.swift is the source of truth)
*.xcodeproj
*.xcworkspace
.build/
DerivedData/
Derived/
Tuist/.build/
*.xcuserstate
xcuserdata/

# Local generation overrides (e.g. HERMES_DEFAULT_SERVER_URL baked in at generate time)
*.local.xcconfig

# Swift Package Manager
.swiftpm/

# TestFlight build artifacts (archive / IPA / ExportOptions) — regenerable
build/

# Signing secrets — NEVER commit. Private keys, certs, profiles, and App Store
# Connect API keys live only on the signer's machine / keychain (see
# docs/development.md → "Signing & contributor setup").
*.p12
*.p8
*.key
*.cer
*.certSigningRequest
*.csr
*.mobileprovision
*.keychain-db

# M0 probe artifacts — regenerable, and the captured session.info frame contains
# the local machine's skills/tools inventory + home paths. Keep out of git.
Probe/fixtures/
/tmp/hermes-probe
